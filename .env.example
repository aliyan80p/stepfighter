# Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------
# Client-exposed (VITE_*) — these ship to the browser.
# Only publishable values belong here. Safe ONLY because Row Level Security
# is enabled on every table in the public schema.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ---------------------------------------------------------------------------
# Server-only. Never prefix any of these with VITE_.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref

# Bypasses RLS. Server runtime only — must never reach client code.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# HMAC signing key for short-lived /api/media/* access tokens (64+ random chars).
MEDIA_TOKEN_SECRET=replace-with-64-char-random-string

# Passphrase for decrypting legacy-encrypted media files.
LEGACY_MEDIA_PASSWORD=replace-with-legacy-media-passphrase

# Shared bearer tokens for the public hook endpoints.
WARM_MEDIA_SECRET=replace-with-random-string
NBME_EXPORT_TOKEN=replace-with-random-string

# Lovable platform + connectors (auto-provisioned in Lovable Cloud).
LOVABLE_API_KEY=auto-provisioned-do-not-hardcode
GOOGLE_DRIVE_API_KEY=connector-managed-do-not-hardcode
LOVABLE_SEND_URL=

# Only used by scripts/restore.mjs during a manual restore.
NEW_DB_URL=postgresql://user:password@host:5432/postgres
