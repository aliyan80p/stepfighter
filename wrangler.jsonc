{
  // Cloudflare Workers deployment for the standby/external hosting of StepFighter.
  // The build already targets Cloudflare (Nitro's default preset in
  // @lovable.dev/vite-tanstack-config), so `npm run build` output is used as-is.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stepfighter",
  "main": "dist/server/index.mjs",
  "compatibility_date": "2025-09-01",
  // Required: node:crypto (HMAC media tokens, OTP hashing) and node:buffer.
  "compatibility_flags": ["nodejs_compat"],
  // Preserve variables and secrets configured in the Cloudflare dashboard.
  // They are intentionally not committed to this repository.
  "keep_vars": true,
  // Public database connection settings required by server-side authentication.
  // These match the VITE_* values embedded into the production browser build.
  "vars": {
    "SUPABASE_URL": "https://veqealgeqcvmqpujdlgo.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_0aAKDWmANScZwVuLGHS6rA_yu9iFpPO",
    "SUPABASE_PROJECT_ID": "veqealgeqcvmqpujdlgo"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  // Nitro already produced a bundled Worker with side-car chunks; ship it as-is.
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "observability": {
    "enabled": true
  }
}

